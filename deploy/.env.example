# ===== 安全 =====
# JWT 签名密钥，必填。生成方式：openssl rand -hex 32
SECRET_KEY=

# ===== PostgreSQL（compose 内 db 服务初始化） =====
POSTGRES_USER=kb
POSTGRES_DB=kb
POSTGRES_PASSWORD=
# api/worker 容器内由 compose 覆盖为 db 服务地址，此变量供本地开发参考
DATABASE_URL=postgresql+asyncpg://kb:changeme@localhost:5432/kb

# ===== LLM（OpenAI 兼容协议），必填 =====
# 无 key 开发兜底：本地 Ollama，如 http://host.docker.internal:11434/v1（API_KEY 填任意占位值）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Embedding（服务器本地推理，不出网） =====
# 默认轻量档 bge-small-zh-v1.5：512 维，常驻内存约 100–200MB，满足 2GB 总预算
# 质量升级档 bge-m3：1024 维，api+worker 双进程需 ~6GB 内存，切换需同步改 EMBEDDING_DIM 并全量重嵌入
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# HuggingFace 国内镜像（可选）：https://hf-mirror.com
# HF_ENDPOINT=

# ===== 注册 =====
# open / invite / closed（运行期不变更，修改需重启；closed 时由管理员建号）
REGISTER_MODE=invite
INVITE_CODE=

# ===== 抓取 =====
# 默认为真实 Chrome UA（自报家门的爬虫 UA 会被大量站点直接 403）
FETCH_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
FETCH_TIMEOUT=20
# 配置后启用 JS 渲染兜底（需 --profile render 启动 browserless）：
# 知乎等依赖浏览器执行 JS 挑战的站点必须走此通道，纯 HTTP 客户端无论请求头如何都会被 403
# 注意：必须用 ws:// 直连并带 token（http:// 会经 /json/version 中转丢失 token，升级时被 403）
# PLAYWRIGHT_CDP_URL=ws://render:3000?token=kb-render

# ===== 渲染 Cookie 注入（可选） =====
# 用于知乎等要求登录态的站点：格式 "k=v; k2=v2"，与 RENDER_COOKIES_DOMAIN 配对
# 知乎最少需要 z_c0（登录凭证）与 d_c0（设备标识），建议整串复制登录浏览器请求头里的 Cookie
# 注意：Cookie 含登录凭据，仅保存在自托管服务器的 .env（已 gitignore），勿外泄
# RENDER_COOKIES=z_c0=xxx; d_c0=yyy; _xsrf=zzz
# RENDER_COOKIES_DOMAIN=.zhihu.com

# ===== Worker =====
WORKER_CONCURRENCY=2

# ===== 其他 =====
# 生产保持 false；开发可置 true 打开 /docs
ENABLE_DOCS=false
TZ=Asia/Shanghai
